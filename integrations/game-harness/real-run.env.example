# Copy these settings into the ignored project .env, or provide its existing path.
# Never put a real API key in this example file or in chat.
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=replace-with-your-key
GAME_MODEL=deepseek-flash
# Same Flash model supports image input for screenshot QA.
MODEL_QA=deepseek-flash
# Optional stronger text/code model; retain Flash for image QA.
# MODEL_BUILD=deepseek-v4-pro
VISION_QA=true
STREAM_BUILD=true
# Set empty for a service that does not accept reasoning_effort.
MODEL_REASONING_EFFORT=none
MATERIAL_PORTAL_URL=web://assets
MAX_CONCURRENT_RUNS=1
MAX_REPAIRS=2
MAX_MODEL_CALLS=16
MAX_TOTAL_TOKENS=300000
RUN_TIMEOUT_SECONDS=1800
MODEL_TIMEOUT_SECONDS=600
BROWSER_TIMEOUT_SECONDS=60
BROWSER_SANDBOX=true
