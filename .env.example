# Copy to .env and fill in your own key. Never commit .env or agent.env.
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=replace-with-your-key
GAME_MODEL=deepseek-flash
# Optional: MODEL_REWRITE, MODEL_DESIGN, MODEL_BUILD, MODEL_QA, MODEL_REPAIR
# Match the verified run configuration; set false for a text-only model.
VISION_QA=true
MODEL_REASONING_EFFORT=none
STREAM_BUILD=true
DATA_DIR=./data
MAX_CONCURRENT_RUNS=1
MAX_REPAIRS=2
MAX_MODEL_CALLS=16
MAX_TOTAL_TOKENS=300000
RUN_TIMEOUT_SECONDS=1800
MODEL_TIMEOUT_SECONDS=600
BROWSER_SANDBOX=true
BROWSER_TIMEOUT_SECONDS=60
HARNESS_API_TOKEN=
# web://assets searches/downloads public artwork; local://references is offline code research.
MATERIAL_PORTAL_URL=web://assets
MATERIAL_PORTAL_TOKEN=
# MATERIAL_PORTAL_SCHEMA=./webmcp/material-portal.schema.json
RAG_DIR=
RAG_API_URL=
RAG_API_TOKEN=
