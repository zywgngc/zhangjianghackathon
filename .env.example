OPENAI_BASE_URL=http://10.176.55.210:8080/v1
OPENAI_API_KEY=replace-with-your-key
GAME_MODEL=qwen3.8-max
# Optional role overrides: MODEL_REWRITE, MODEL_DESIGN, MODEL_BUILD, MODEL_QA, MODEL_REPAIR
DATA_DIR=./data
MAX_CONCURRENT_RUNS=2
MAX_REPAIRS=2
MAX_MODEL_CALLS=16
MAX_TOTAL_TOKENS=100000
RUN_TIMEOUT_SECONDS=1200
MODEL_TIMEOUT_SECONDS=300
BROWSER_SANDBOX=true
BROWSER_TIMEOUT_SECONDS=60
VISION_QA=true
STREAM_BUILD=true
# qwen3.8-max endpoint verified with none. Empty value omits this parameter for other providers.
MODEL_REASONING_EFFORT=none
# Set a token to protect API calls on shared networks. UI accepts this token.
HARNESS_API_TOKEN=
# Optional extra Markdown knowledge directory and existing RAG service adapter.
RAG_DIR=
RAG_API_URL=
# RAG_API_TOKEN=
# Optional HTTP bridge implementing the teammate's MaterialPortalPort v0.1 contract.
# The actual MCP tool names/transport still require agreement with the portal owner.
MATERIAL_PORTAL_URL=
# MATERIAL_PORTAL_TOKEN=
# MATERIAL_PORTAL_SCHEMA=./webmcp/material-portal.schema.json
