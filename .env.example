OPENAI_BASE_URL=http://10.176.55.210:8080/v1
OPENAI_API_KEY=replace-with-your-key
GAME_MODEL=qwen3.8-max
# Optional role overrides: MODEL_REWRITE, MODEL_DESIGN, MODEL_BUILD, MODEL_QA, MODEL_REPAIR
DATA_DIR=./data
MAX_CONCURRENT_RUNS=2
MAX_REPAIRS=2
MAX_MODEL_CALLS=16
MAX_TOTAL_TOKENS=100000
RUN_TIMEOUT_SECONDS=1200
MODEL_TIMEOUT_SECONDS=300
BROWSER_SANDBOX=true
BROWSER_TIMEOUT_SECONDS=60
VISION_QA=true
STREAM_BUILD=true
# qwen3.8-max endpoint verified with none. Empty value omits this parameter for other providers.
MODEL_REASONING_EFFORT=none
# Set a token to protect API calls on shared networks. UI accepts this token.
HARNESS_API_TOKEN=
# Optional extra Markdown knowledge directory and existing RAG service adapter.
RAG_DIR=
RAG_API_URL=
# RAG_API_TOKEN=
# Optional initial-search HTTP bridge for the teammate's MaterialPortalPort v0.2 contract.
# The actual MCP tool names/transport still require agreement with the portal owner.
MATERIAL_PORTAL_URL=
# MATERIAL_PORTAL_TOKEN=
# MATERIAL_PORTAL_SCHEMA=./webmcp/material-portal.schema.json
# Optional durable research sidecar. Separate from the external material portal above.
# scripts/run_integrated.py configures these in memory when launching both services.
WEBMCP_RESEARCH_URL=
# WEBMCP_RESEARCH_TOKEN=match-the-node-WEBMCP_TOKEN-at-least-16-characters
# Node sidecar settings, if launching it separately:
# WEBMCP_TOKEN=match-the-harness-WEBMCP_RESEARCH_TOKEN
# WEBMCP_DB=/local-disk/webmcp/research.sqlite
# WebMCP owns public GitHub archetype discovery; networking is OFF by default.
WEBMCP_GITHUB_NETWORK=off
# Explicit bounded networking opt-in: WEBMCP_GITHUB_NETWORK=bounded
# WEBMCP_RESEARCH_MODE=live
# Optional server-only GitHub token. Never sent to the browser or MaterialPortal.
# WEBMCP_GITHUB_TOKEN=
# For offline tests/demos only: WEBMCP_RESEARCH_MODE=fixtures

# Long projects keep their own policy and usage, independent of quick demos.
PROJECT_MAX_MODEL_CALLS=600
PROJECT_MAX_TOTAL_TOKENS=6000000
PROJECT_TIMEOUT_SECONDS=21600
PROJECT_FEATURE_STEPS=36
PROJECT_REPAIR_ROUNDS=8
